# Tomato Monitor — Environment Variables
# Copy this file to .env and adjust values as needed.
# The real .env file MUST NOT be committed to version control.

# Execution profile: "edge" (conservative, for Raspberry Pi) or "full" (development PC)
TOMATO_MONITOR_PROFILE=edge

# Camera toggle (set to "true" to enable live camera on Raspberry Pi)
CAMERA_ENABLED=false

# Input source: "live_camera" (production) or "offline_video" (benchmarking/testing)
INPUT_SOURCE=live_camera

# --- Authentication ---
# Secret key for signing session cookies (generate with: python -c "import secrets; print(secrets.token_hex(32))")
# If not set, an ephemeral secret is used (sessions lost on restart).
TOMATO_MONITOR_SESSION_SECRET=

# Session cookie name (default: tomato_session)
TOMATO_MONITOR_SESSION_COOKIE_NAME=tomato_session

# Session duration in seconds (default: 86400 = 24 hours)
TOMATO_MONITOR_SESSION_MAX_AGE_SECONDS=86400

# --- Bootstrap Admin ---
# If set AND the database has no users, an admin user is created on startup.
TOMATO_MONITOR_BOOTSTRAP_ADMIN_EMAIL=
TOMATO_MONITOR_BOOTSTRAP_ADMIN_PASSWORD=
TOMATO_MONITOR_BOOTSTRAP_ADMIN_NAME=Administrador

# NOTE: Do not store secrets, tokens, or passwords here.
# This file is a TEMPLATE showing which variables the system reads.
