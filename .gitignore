# Entornos virtuales
.venv/
venv/
ENV/
env/
bin/
lib/
include/
share/

# Kiro temporary files (steering, specs, hooks, settings ARE versioned)
.kiro/cache/
.kiro/tmp/
.kiro/logs/

# Python cache y compilados
__pycache__/
*.py[cod]
*$py.class

# Distribución / Empaquetado
dist/
build/
*.egg-info/

# Variables de entorno (¡Seguridad!)
.env

# SQLite database files
data/*.db
data/*.db-wal
data/*.db-shm

# Outputs (snapshots, annotated images, pipeline_metrics, reports)
outputs/

# Model weights (large binary files)
models/**/*.pth

# Test caches
.hypothesis/
.pytest_cache/
